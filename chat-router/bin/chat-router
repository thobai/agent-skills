#!/usr/bin/env python3
"""Route Google Chat replies into running Herdr agent panes.

Instead of each agent blocking on a poll loop, sessions register themselves
(``chat-router send``) and one long-lived router (``chat-router watch``) turns
every human Chat message into a prompt for the right agent pane.

  chat-router send --session <id> "text"   fire-and-forget notify + register
  chat-router watch                        the daemon (one per machine)
  chat-router list                         show the registry
  chat-router unregister --session <id>    drop one entry (or --stale for all dead)

Routing is by Chat thread: each session owns one thread, keyed by session id.
A human message in that thread is injected into that session's pane. Messages
posted by the webhook are BOT-sent and always ignored, so the router cannot
feed an agent its own output.

Stale targets: the pane id plus the terminal id recorded at registration must
both still be live. Herdr does not reuse closed pane ids, but a pane whose
agent exits and is replaced keeps its id, so the terminal id is what actually
proves the registered session is still the pane's occupant.

Exit codes: 0 normal, 2 configuration or gws failure.
"""

from __future__ import annotations

import argparse
import fcntl
import json
import os
import re
import shutil
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from datetime import datetime, timezone
from pathlib import Path

STATE_DIR = Path(
    os.environ.get("CHAT_ROUTER_STATE_DIR", Path.home() / ".local" / "state" / "chat-router")
)
REGISTRY = STATE_DIR / "registry.json"
LOCK = STATE_DIR / "registry.lock"
LOGFILE = STATE_DIR / "router.log"

SEEN_CAP = 300  # message ids retained for dedup
INJECT_CAP = 1800  # characters of chat text passed to the agent
ENV_FILE = Path(
    os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")
) / "agent-skills" / "env"


# ---------------------------------------------------------------- configuration


def load_env() -> None:
    """Populate NOTIFY_ME_* from the agent-skills env file if not already set.

    Agents run with a non-interactive shell that never sourced ~/.zshrc, so the
    config file is the reliable source.
    """
    if not ENV_FILE.exists():
        return
    for line in ENV_FILE.read_text().splitlines():
        m = re.match(r'\s*(?:export\s+)?([A-Z_][A-Z0-9_]*)\s*=\s*(.*)\s*$', line)
        if not m:
            continue
        key, val = m.group(1), m.group(2).strip()
        if val[:1] in "\"'" and val[-1:] == val[:1]:
            val = val[1:-1]
        os.environ.setdefault(key, val)


def require(name: str) -> str:
    val = os.environ.get(name)
    if not val:
        die(f"{name} is not set (expected in {ENV_FILE})")
    return val


def die(msg: str) -> None:
    print(json.dumps({"error": msg}), file=sys.stderr)
    sys.exit(2)


def now_iso() -> str:
    return datetime.now(timezone.utc).isoformat(timespec="microseconds").replace("+00:00", "Z")


def log(msg: str) -> None:
    line = f"{now_iso()} {msg}"
    print(line, flush=True)
    try:
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        with LOGFILE.open("a") as fh:
            fh.write(line + "\n")
    except OSError:
        pass


# -------------------------------------------------------------------- registry


class Registry:
    """JSON registry guarded by an flock, so send and watch can both write."""

    def __init__(self) -> None:
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        self._fh = LOCK.open("w")
        self.data: dict = {}

    def __enter__(self) -> "Registry":
        fcntl.flock(self._fh, fcntl.LOCK_EX)
        try:
            self.data = json.loads(REGISTRY.read_text())
        except (OSError, json.JSONDecodeError):
            self.data = {}
        self.data.setdefault("sessions", {})
        self.data.setdefault("seen", [])
        self.data.setdefault("pending", {})
        self.data.setdefault("watermark", None)
        return self

    def __exit__(self, *exc) -> None:
        try:
            if exc[0] is None:
                self.data["seen"] = self.data["seen"][-SEEN_CAP:]
                tmp = REGISTRY.with_suffix(".tmp")
                tmp.write_text(json.dumps(self.data, indent=2))
                tmp.replace(REGISTRY)
        finally:
            fcntl.flock(self._fh, fcntl.LOCK_UN)
            self._fh.close()


def read_registry() -> dict:
    try:
        return json.loads(REGISTRY.read_text())
    except (OSError, json.JSONDecodeError):
        return {"sessions": {}, "seen": [], "watermark": None}


# ------------------------------------------------------------------------ gws


def gws_json(args: list[str], timeout: int = 20) -> dict:
    """Run gws and parse its JSON, skipping the keyring preamble.

    A poll that hangs would stall the whole loop, so it is bounded: when a
    proxy blackholes the connection, gws can sit for 90 seconds.
    """
    try:
        p = subprocess.run(["gws", *args], capture_output=True, text=True, timeout=timeout)
    except subprocess.TimeoutExpired:
        return {"error": {"message": f"gws timed out after {timeout}s"}}
    lines = p.stdout.splitlines()
    start = next((i for i, ln in enumerate(lines) if ln[:1] in "{["), None)
    if start is None:
        return {"error": {"message": (p.stderr or p.stdout or "no output").strip()[:300]}}
    try:
        return json.loads("\n".join(lines[start:]))
    except json.JSONDecodeError as e:
        return {"error": {"message": f"unparseable gws response: {e}"}}


def fetch_recent(space: str, limit: int) -> tuple[list[dict], str | None]:
    """Newest-first page of space messages."""
    params = json.dumps({"parent": space, "pageSize": limit, "orderBy": "createTime desc"})
    d = gws_json(["chat", "spaces", "messages", "list", "--params", params])
    if "error" in d:
        return [], json.dumps(d["error"])[:300]
    return d.get("messages") or [], None


def post_webhook(text: str, *, thread_key: str | None = None,
                 thread_name: str | None = None) -> dict:
    """Post to the space webhook. thread_key binds a session to one thread."""
    url = require("NOTIFY_ME_WEBHOOK_URL")
    # Chat parses standard Markdown only when asked; the default Chat syntax
    # would render **bold** and [label](url) literally.
    body: dict = {"text": text, "markupSyntax": "MARKUP_SYNTAX_MARKDOWN"}
    if thread_name:
        body["thread"] = {"name": thread_name}
    elif thread_key:
        body["thread"] = {"threadKey": thread_key}
    if "thread" in body:
        sep = "&" if "?" in url else "?"
        url = f"{url}{sep}messageReplyOption=REPLY_MESSAGE_FALLBACK_TO_NEW_THREAD"
    req = urllib.request.Request(
        url, data=json.dumps(body).encode(), headers={"Content-Type": "application/json"}
    )
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            return json.loads(resp.read().decode())
    except urllib.error.HTTPError as e:
        return {"error": f"webhook HTTP {e.code}: {e.read().decode()[:200]}"}
    except (urllib.error.URLError, TimeoutError) as e:
        return {"error": f"webhook unreachable: {e}"}


TABLE_SEP = re.compile(r"^\s*\|?[\s:|-]*-[\s:|-]*\|?\s*$")


def to_chat_markdown(text: str) -> str:
    """Make agent Markdown safe for Chat's Markdown renderer.

    Chat handles headings, bold, italic, strikethrough, inline code, fenced
    code, bullets, nested bullets, numbered lists, block quotes and links.
    Two things it does not handle:

    - Tables are destructive: cells are concatenated without separators and
      the following line can be swallowed. Wrapping a table in a code fence
      keeps it aligned and readable instead.
    - Horizontal rules vanish silently, so drop them rather than let an agent
      believe a separator was delivered.
    """
    lines = (text or "").split("\n")
    out: list[str] = []
    in_fence = False
    i = 0
    while i < len(lines):
        line = lines[i]
        if line.lstrip().startswith("```"):
            in_fence = not in_fence
            out.append(line)
            i += 1
            continue
        if in_fence:
            out.append(line)
            i += 1
            continue
        # A table is a pipe row followed by a dashed separator row.
        if (line.lstrip().startswith("|") and i + 1 < len(lines)
                and TABLE_SEP.match(lines[i + 1]) and "|" in lines[i + 1]):
            block = []
            while i < len(lines) and lines[i].lstrip().startswith("|"):
                block.append(lines[i].rstrip())
                i += 1
            out += ["```", *block, "```"]
            continue
        if re.match(r"^\s*([-*_])\s*(\1\s*){2,}$", line):  # horizontal rule
            i += 1
            continue
        out.append(line)
        i += 1
    # Dropping a rule leaves a blank line on each side of where it was.
    return re.sub(r"\n{3,}", "\n\n", "\n".join(out)).strip()


# -------------------------------------------------------------- name matching


def recent_sessions(sessions: dict, limit: int = 5) -> list[str]:
    return sorted(sessions, key=lambda s: sessions[s].get("last_sent_at") or "",
                  reverse=True)[:limit]


def resolve_name(text: str, sessions: dict) -> tuple[str | None, str]:
    """Match a reply like 'orchestrator' or 'send to orch' to one live session.

    Returns (session, remaining_text); the remainder is content he wrote
    alongside the name. Unmatched or ambiguous gives (None, '').
    """
    raw = (text or "").strip()
    t = raw.lower()
    if not t or not sessions:
        return None, ""

    exact = [s for s in sessions if s.lower() == t.strip("`\"'.,:;!? ")]
    contained = [s for s in sessions if s.lower() in t]
    tokens = [w.strip("`\"'.,:;!?") for w in t.split()]
    # Allow an unambiguous abbreviation: 'orch' for 'orchestrator'.
    prefixed = [s for s in sessions
                if any(len(w) >= 3 and s.lower().startswith(w) for w in tokens)]

    found = exact if len(exact) == 1 else (contained or prefixed)
    if len(found) != 1:
        return None, ""
    session = found[0]
    # Remove whatever named the session — the full name or the abbreviation he
    # used — so the remainder is only content meant for the agent.
    used = [session] + [w for w in tokens
                        if len(w) >= 3 and session.lower().startswith(w)]
    remainder = raw
    for word in sorted(used, key=len, reverse=True):
        remainder = re.sub(re.escape(word), "", remainder, flags=re.I)
    return session, remainder.strip(" `\"'.,:;!?-\n")


# ---------------------------------------------------------------------- herdr


def herdr(args: list[str]) -> dict:
    p = subprocess.run(["herdr", *args], capture_output=True, text=True)
    try:
        return json.loads(p.stdout or p.stderr or "{}")
    except json.JSONDecodeError:
        return {"error": {"message": (p.stderr or p.stdout).strip()[:300]}}


def agent_info(target: str) -> dict | None:
    d = herdr(["agent", "get", target])
    return (d.get("result") or {}).get("agent")


def target_alive(entry: dict) -> tuple[bool, str]:
    """A target is alive only if the pane still hosts the same terminal."""
    info = agent_info(entry["pane_id"])
    if not info:
        return False, "no agent in pane"
    if info.get("terminal_id") != entry.get("terminal_id"):
        return False, (
            f"terminal changed ({entry.get('terminal_id')} -> {info.get('terminal_id')})"
        )
    return True, info.get("agent_status", "unknown")


def flatten(text: str) -> str:
    """Collapse whitespace: a newline in an injected prompt submits it early."""
    return re.sub(r"\s+", " ", (text or "").strip())[:INJECT_CAP]


def inject(entry: dict, session: str, text: str) -> bool:
    # Terse on purpose: this prefix is prepended to every reply an agent reads,
    # so boilerplate here is a recurring token and attention cost.
    prompt = f"[chat:{session}] {flatten(text)}"
    d = herdr(["agent", "prompt", entry["pane_id"], prompt])
    if "error" in d:
        log(f"inject FAILED session={session} pane={entry['pane_id']} err={d['error']}")
        return False
    return True


# ------------------------------------------------------------------ subcommands


def cmd_send(args: argparse.Namespace) -> int:
    space = require("NOTIFY_ME_SPACE_ID")
    session = args.session
    pane = args.pane or os.environ.get("HERDR_PANE_ID")
    if not pane:
        die("no target pane: run inside Herdr or pass --pane")

    info = agent_info(pane)
    if not info:
        die(f"no agent found in pane {pane}")

    if args.name or not info.get("name"):
        herdr(["agent", "rename", pane, args.name or session])
        info = agent_info(pane) or info

    with Registry() as reg:
        entry = reg.data["sessions"].get(session, {})
        # Thread previews in Chat show only the message text, so the label is
        # what tells Thomas which agent and repo is asking.
        text = to_chat_markdown(args.text)
        if not args.no_label:
            cwd = Path(info.get("cwd") or ".")
            where = "" if cwd == Path.home() else cwd.name
            label = f"**[{session} · {where}]**" if where else f"**[{session}]**"
            # Keep a multi-line message's first line free for the label so the
            # thread preview shows who is asking.
            sep = "\n" if "\n" in text else " "
            text = f"{label}{sep}{text}"
        sent = post_webhook(
            text,
            thread_key=session,
            # An adopted thread replaces the session's own, so both directions
            # of the conversation stay in the thread Thomas is reading.
            thread_name=entry.get("thread"),
        )
        if "error" in sent:
            die(sent["error"])
        thread = (sent.get("thread") or {}).get("name")
        reg.data["sessions"][session] = {
            "thread": thread,
            "pane_id": pane,
            "terminal_id": info.get("terminal_id"),
            "agent_name": info.get("name"),
            "agent_kind": info.get("agent"),
            "cwd": info.get("cwd"),
            "registered_at": entry.get("registered_at") or now_iso(),
            "last_sent_at": now_iso(),
        }
        # A registration in the past must not make the router replay history.
        if reg.data.get("watermark") is None:
            reg.data["watermark"] = now_iso()

    out = {
        "session": session,
        "thread": thread,
        "message_id": sent.get("name"),
        "target": pane,
        "agent_name": info.get("name"),
        "routed": True,
    }
    print(json.dumps(out))
    return 0


def cmd_watch(args: argparse.Namespace) -> int:
    space = require("NOTIFY_ME_SPACE_ID")
    require("NOTIFY_ME_WEBHOOK_URL")
    log(f"router start space={space} interval={args.interval}s fallback={args.fallback}")

    fails = 0
    while True:
        msgs, err = fetch_recent(space, args.page_size)
        if err:
            fails += 1
            log(f"poll error ({fails}/{args.max_errors}): {err}")
            # gws appears to cache the system trust store at startup, so a
            # long-lived process keeps failing with UnknownIssuer after a
            # proxy's CA changes while a fresh process succeeds. Exiting lets
            # the supervisor restart us with a current trust store.
            if fails >= args.max_errors:
                log("too many consecutive poll failures - exiting for a fresh start")
                return 1
        else:
            fails = 0
            process(list(reversed(msgs)), args)  # oldest-first
        if args.once:
            return 0
        time.sleep(args.interval)


def process(msgs: list[dict], args: argparse.Namespace) -> None:
    with Registry() as reg:
        sessions = reg.data["sessions"]
        seen = set(reg.data["seen"])
        watermark = reg.data["watermark"] or now_iso()
        reg.data["watermark"] = watermark

        for m in msgs:
            mid, created = m.get("name"), m.get("createTime") or ""
            if not mid or mid in seen:
                continue
            if created <= watermark:
                continue
            if (m.get("sender") or {}).get("type") != "HUMAN":
                reg.data["watermark"] = max(reg.data["watermark"], created)
                continue

            thread = (m.get("thread") or {}).get("name")
            session = next((s for s, e in sessions.items() if e.get("thread") == thread), None)
            if session is None and args.fallback == "last" and sessions:
                session = max(sessions, key=lambda s: sessions[s].get("last_sent_at") or "")
                log(f"no session for thread {thread} -> fallback session={session}")

            reg.data["seen"].append(mid)
            reg.data["watermark"] = max(reg.data["watermark"], created)

            if session is None:
                handle_unmatched(reg, sessions, thread, m.get("text") or "", mid)
                continue

            entry = sessions[session]
            alive, why = target_alive(entry)
            if not alive:
                log(f"stale target session={session} pane={entry['pane_id']} ({why}) - dropping")
                del sessions[session]
                if entry.get("thread") and not args.quiet_stale:
                    post_webhook(
                        f"Session `{session}` is no longer running ({why}). "
                        f"Message not delivered.",
                        thread_name=entry["thread"],
                    )
                continue

            if inject(entry, session, m.get("text") or ""):
                log(f"delivered session={session} pane={entry['pane_id']} status={why}")


# ------------------------------------------------------- daemon (launchd/tmux)

LAUNCHD_LABEL = "com.thobai.chat-router"
LAUNCHD_PLIST = Path.home() / "Library" / "LaunchAgents" / f"{LAUNCHD_LABEL}.plist"
TMUX_SESSION = "chat-router"


def self_path() -> str:
    return str(Path(__file__).resolve())


def daemon_path() -> str:
    """PATH the daemon needs: this script, herdr, gws, tmux, and system bins."""
    dirs = [str(Path(self_path()).parent), str(Path.home() / ".local" / "bin")]
    for tool in ("herdr", "gws", "tmux"):
        found = shutil.which(tool)
        if found:
            dirs.append(str(Path(found).parent))
    dirs += ["/opt/homebrew/bin", "/usr/local/bin", "/usr/bin", "/bin"]
    seen, out = set(), []
    for d in dirs:
        if d and d not in seen:
            seen.add(d)
            out.append(d)
    return ":".join(out)


def sh(cmd: str) -> subprocess.CompletedProcess:
    """Run cmd in a non-login shell.

    A login shell would source the user's rc files, whose shell-integration
    escape codes end up in stdout and corrupt parsing.
    """
    env = dict(os.environ, PATH=daemon_path())
    return subprocess.run(["/bin/bash", "-c", cmd], capture_output=True, text=True, env=env)


def launchd_running() -> bool:
    return sh(f"launchctl print gui/$(id -u)/{LAUNCHD_LABEL} >/dev/null 2>&1").returncode == 0


def tmux_running() -> bool:
    return sh(f"tmux has-session -t {TMUX_SESSION} 2>/dev/null").returncode == 0


def stop_launchd() -> None:
    sh(f"launchctl bootout gui/$(id -u)/{LAUNCHD_LABEL} 2>/dev/null || "
       f"launchctl unload -w '{LAUNCHD_PLIST}' 2>/dev/null")


def stop_tmux() -> None:
    sh(f"tmux kill-session -t {TMUX_SESSION} 2>/dev/null")


def write_plist(interval: int) -> None:
    LAUNCHD_PLIST.parent.mkdir(parents=True, exist_ok=True)
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    plist = f"""<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>{LAUNCHD_LABEL}</string>
  <key>ProgramArguments</key>
  <array>
    <string>{self_path()}</string>
    <string>watch</string>
    <string>--interval</string>
    <string>{interval}</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>{daemon_path()}</string>
    <key>HOME</key><string>{Path.home()}</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>{STATE_DIR / 'launchd.out'}</string>
  <key>StandardErrorPath</key><string>{STATE_DIR / 'launchd.err'}</string>
</dict>
</plist>
"""
    LAUNCHD_PLIST.write_text(plist)


def cmd_daemon(args: argparse.Namespace) -> int:
    if args.action == "status":
        return daemon_status()

    flavour = args.flavour
    if flavour is None:
        flavour = "launchd" if sys.platform == "darwin" else "tmux"
    if flavour == "launchd" and sys.platform != "darwin":
        die("launchd is macOS only; use --tmux")

    if args.action == "uninstall":
        stop_launchd()
        stop_tmux()
        if LAUNCHD_PLIST.exists() and not args.keep_plist:
            LAUNCHD_PLIST.unlink()
        print(json.dumps({"uninstalled": True}))
        return 0

    # Idempotent by default: several agents onboarding at once would otherwise
    # each tear down a working daemon and start their own.
    already = launchd_running() if flavour == "launchd" else tmux_running()
    if already and not args.force:
        print(json.dumps({"installed": flavour, "already_running": True,
                          "changed": False}))
        return 0

    # Only one router should supervise a registry, so retire the other flavour.
    stop_launchd()
    stop_tmux()

    if flavour == "launchd":
        write_plist(args.interval)
        r = sh(f"launchctl bootstrap gui/$(id -u) '{LAUNCHD_PLIST}' 2>&1 || "
               f"launchctl load -w '{LAUNCHD_PLIST}' 2>&1")
        time.sleep(2)
        if not launchd_running():
            die(f"launchd did not start: {(r.stdout + r.stderr).strip()[:200]}")
        print(json.dumps({"installed": "launchd", "label": LAUNCHD_LABEL,
                          "plist": str(LAUNCHD_PLIST), "survives_reboot": True}))
    else:
        if not sh("command -v tmux").stdout.strip():
            die("tmux not found")
        # Mirror launchd's KeepAlive: the watcher exits on repeated poll
        # failures so it can come back with a fresh trust store.
        sh(f"tmux new-session -d -s {TMUX_SESSION} "
           f"'export PATH=\"{daemon_path()}\"; "
           f"while true; do {self_path()} watch --interval {args.interval}; sleep 5; done'")
        time.sleep(2)
        if not tmux_running():
            die("tmux session did not start")
        print(json.dumps({"installed": "tmux", "session": TMUX_SESSION,
                          "survives_reboot": False}))
    return 0


def daemon_status() -> int:
    raw = sh("pgrep -f 'chat-router watch' || true").stdout
    procs = len([ln for ln in raw.splitlines() if ln.strip().isdigit()])
    out = {
        "launchd": launchd_running(),
        "tmux": tmux_running(),
        "processes": procs,
        "plist": str(LAUNCHD_PLIST) if LAUNCHD_PLIST.exists() else None,
        "log": str(LOGFILE),
    }
    if out["processes"] == 0:
        out["warning"] = "no router running: messages will send but no replies come back"
    elif out["processes"] > 1:
        out["warning"] = (f"{out['processes']} routers running; duplicate delivery is "
                          "prevented by the registry lock but only one is needed")
    print(json.dumps(out, indent=2))
    return 0


def handle_unmatched(reg, sessions: dict, thread: str | None, text: str, mid: str) -> None:
    """No session owns this thread.

    First message: hold it and ask who it is for. Next message: if it names a
    live session, bind this thread to that session and forward everything held.
    Guessing a target instead would hand one agent another's instructions.
    """
    pending = reg.data.setdefault("pending", {})
    if not thread:
        log(f"no route for msg={mid.split('/')[-1]} (no thread)")
        return

    held = pending.get(thread)
    if held:
        session, remainder = resolve_name(text, sessions)
        if session:
            entry = sessions[session]
            alive, why = target_alive(entry)
            if not alive:
                del sessions[session]
                post_webhook(f"`{session}` is no longer running ({why}). "
                             f"Still holding your message.", thread_name=thread)
                return
            # This thread becomes the session's inbox and outbox from now on.
            entry["thread"] = thread
            forwarded = " — ".join([*held["texts"], remainder] if remainder else held["texts"])
            if inject(entry, session, forwarded):
                del pending[thread]
                log(f"adopted thread={thread.split('/')[-1]} session={session}")
                post_webhook(f"Routed to `{session}`. This thread reaches it from now on.",
                             thread_name=thread)
            return
        held["texts"].append(text)
        ask_who(sessions, thread, held=len(held["texts"]))
        return

    pending[thread] = {"texts": [text], "asked_at": now_iso()}
    # Keep the pending map from growing without bound.
    for old in list(pending)[:-20]:
        del pending[old]
    log(f"no route for msg={mid.split('/')[-1]} thread={thread} - holding")
    ask_who(sessions, thread, held=1)


def ask_who(sessions: dict, thread: str, held: int) -> None:
    names = recent_sessions(sessions)
    if not names:
        post_webhook("**Not delivered** — no agents are registered right now.",
                     thread_name=thread)
        return
    listed = ", ".join(f"`{s}`" for s in names)
    plural = "message" if held == 1 else f"{held} messages"
    note = post_webhook(
        f"**Not delivered** — no agent owns this thread. Holding your {plural}. "
        f"Reply with a name to route it: {listed}",
        thread_name=thread,
    )
    if "error" in note:
        log(f"could not post not-delivered note: {note['error']}")


def cmd_list(args: argparse.Namespace) -> int:
    data = read_registry()
    if args.json:
        print(json.dumps(data, indent=2))
        return 0
    sessions = data.get("sessions") or {}
    if not sessions:
        print("no registered sessions")
        return 0
    print(f"{'SESSION':<24} {'PANE':<10} {'STATE':<10} THREAD")
    for s, e in sorted(sessions.items(), key=lambda kv: kv[1].get("last_sent_at") or ""):
        alive, why = target_alive(e)
        print(f"{s:<24} {e.get('pane_id',''):<10} {(why if alive else 'STALE'):<10} "
              f"{(e.get('thread') or '').split('/')[-1]}")
    print(f"\nwatermark: {data.get('watermark')}")
    return 0


def cmd_unregister(args: argparse.Namespace) -> int:
    with Registry() as reg:
        sessions = reg.data["sessions"]
        if args.stale:
            dropped = [s for s, e in list(sessions.items()) if not target_alive(e)[0]]
            for s in dropped:
                del sessions[s]
            print(json.dumps({"dropped": dropped}))
        elif args.session:
            existed = sessions.pop(args.session, None) is not None
            print(json.dumps({"dropped": [args.session] if existed else []}))
        else:
            die("pass --session <id> or --stale")
    return 0


def main() -> int:
    load_env()
    ap = argparse.ArgumentParser(prog="chat-router", description=__doc__.splitlines()[0])
    sub = ap.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("send", help="notify Thomas and register this pane for replies")
    s.add_argument("text")
    s.add_argument("--session", required=True, help="stable session id; owns one Chat thread")
    s.add_argument("--pane", help="target pane id (default: $HERDR_PANE_ID)")
    s.add_argument("--name", help="rename the Herdr agent to this (default: session id)")
    s.add_argument("--no-label", action="store_true",
                   help="omit the [session · repo] prefix")
    s.set_defaults(func=cmd_send)

    w = sub.add_parser("watch", help="run the router daemon")
    w.add_argument("--interval", type=int, default=2)
    w.add_argument("--page-size", type=int, default=25)
    w.add_argument("--once", action="store_true")
    w.add_argument("--max-errors", type=int, default=5,
                   help="exit after this many consecutive poll failures so the "
                        "supervisor restarts the process")
    w.add_argument("--fallback", choices=["last", "none"], default="none",
                   help="'last' routes a message from an unknown thread to the most "
                        "recently active session; the default refuses and says so in Chat")
    w.add_argument("--quiet-stale", action="store_true",
                   help="do not post a Chat note when a target is gone")
    w.set_defaults(func=cmd_watch)

    d = sub.add_parser("daemon", help="install/inspect the router daemon (launchd or tmux)")
    d.add_argument("action", choices=["install", "status", "uninstall"])
    d.add_argument("--launchd", dest="flavour", action="store_const", const="launchd",
                   help="supervise with launchd (macOS, survives reboot)")
    d.add_argument("--tmux", dest="flavour", action="store_const", const="tmux",
                   help="supervise with a detached tmux session")
    d.add_argument("--interval", type=int, default=2)
    d.add_argument("--force", action="store_true",
                   help="reinstall even if that flavour is already running")
    d.add_argument("--keep-plist", action="store_true", help="uninstall without deleting the plist")
    d.set_defaults(func=cmd_daemon, flavour=None)

    l = sub.add_parser("list", help="show registered sessions")
    l.add_argument("--json", action="store_true")
    l.set_defaults(func=cmd_list)

    u = sub.add_parser("unregister", help="drop registry entries")
    u.add_argument("--session")
    u.add_argument("--stale", action="store_true")
    u.set_defaults(func=cmd_unregister)

    args = ap.parse_args()
    return args.func(args)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        log("router stopped")
        sys.exit(0)
